{
  "name": "lv-design-studio",
  "productName": "LV Design Studio",
  "version": "1.48.0",
  "license": "SEE LICENSE IN LICENSE.md",
  "description": "Offline LV electrical design & calculation desktop app",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac dmg:arm64",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "update-app": "bash scripts/update-app.sh",
    "bench": "vitest run -c tests/performance/vitest.config.ts",
    "test:pdf": "vitest run -c tests/pdf/vitest.config.ts",
    "test:pdf:update": "UPDATE_BASELINES=1 vitest run -c tests/pdf/vitest.config.ts tests/pdf/visual.pdf.ts",
    "build:cli": "vite build -c vite.cli.config.ts",
    "lvds": "node dist-cli/lvds.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xmldom/xmldom": "^0.8.15",
    "docx": "^9.8.1",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^8.2.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "pdfjs-dist": "^6.4.299",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wait-on": "^7.2.0"
  },
  "overrides": {
    "shell-quote": "1.11.0"
  },
  "build": {
    "appId": "com.lvdesignstudio.app",
    "icon": "build/icon.png",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": {
        "target": "dmg",
        "arch": [
          "arm64"
        ]
      },
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    },
    "linux": {
      "target": "AppImage"
    },
    "extraResources": [
      {
        "from": "engines/python",
        "to": "python",
        "filter": [
          "*.py"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "artifactName": "LV-Design-Studio-${version}-${os}-${arch}.${ext}"
  },
  "author": "Palanisami",
  "bin": {
    "lvds": "dist-cli/lvds.mjs"
  }
}
