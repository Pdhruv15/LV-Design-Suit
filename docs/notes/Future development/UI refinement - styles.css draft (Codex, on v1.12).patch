+.home-act{display:grid;grid-template-columns:auto 1fr;grid-template-rows:auto auto;column-gap:var(--space-3);row-gap:2px;align-items:center;min-height:86px;text-align:left;padding:var(--space-4);border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--panel);color:var(--tx);cursor:pointer;font:inherit;box-shadow:var(--shadow-sm);transition:transform .15s ease,border-color .15s ease,background-color .15s ease}
 .home-act svg{grid-row:span 2;color:var(--acc)}
-.home-act b{font-size:15px}
-.home-act span{color:var(--mut);font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
-.home-act:hover:not(:disabled){border-color:var(--acc)}
+.home-act b{font-size:15px;line-height:1.3;letter-spacing:-.01em}
+.home-act span{color:var(--mut);font-size:12px;line-height:1.4;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+.home-act:hover:not(:disabled){border-color:var(--acc);background:color-mix(in srgb,var(--acc) 6%,var(--panel));transform:translateY(-1px)}
 .home-act.primary{background:color-mix(in srgb,var(--acc) 16%,var(--panel));border-color:color-mix(in srgb,var(--acc) 50%,var(--line))}
 .home-act:disabled{opacity:.55;cursor:default}
 .top .home-links{display:flex;gap:6px}
