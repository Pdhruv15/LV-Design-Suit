        "kind": {
          "type": "string",
          "const": "fixtures"
        },
        "items": {
          "minItems": 1,
          "maxItems": 50000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "room": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "description": "Project room ID, or the sourceId of a room imported from CAD / IFC"
              },
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60,
                "description": "Luminaire type code"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "quantity": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 100000
              },
              "inputW": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100000,
                "description": "Input power of one luminaire, W"
              },
              "voltageV": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000
              },
              "pf": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1,
                "description": "Power factor"
              },
              "use": {
                "type": "string",
                "enum": [
                  "normal",
                  "emergency"
                ]
              }
            },
            "required": [
              "room",
              "code",
              "quantity",
              "inputW",
              "use"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema",
        "version",
        "source",
        "exportedAt",
        "kind",
        "items"
      ],
      "additionalProperties": false
    },
