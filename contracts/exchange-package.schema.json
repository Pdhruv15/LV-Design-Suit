          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "description": "Stable ID of the supply in the source, e.g. FA-PANEL-01"
              },
              "system": {
                "type": "string",
                "enum": [
                  "fire-alarm",
                  "cctv",
                  "access-control",
                  "ict",
                  "public-address",
                  "bms",
                  "other"
                ]
              },
              "equipment": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "What the LV circuit feeds: panel, PSU, PoE switch, UPS, rack, amplifier"
              },
              "equipmentType": {
                "type": "string",
                "enum": [
                  "panel",
                  "psu",
                  "poe-switch",
                  "ups",
                  "rack",
                  "amplifier",
                  "other"
                ]
              },
              "rooms": {
                "description": "Rooms served: project room IDs or imported room sourceIds",
