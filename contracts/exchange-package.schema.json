              },
              "supply": {
                "type": "string",
                "enum": [
                  "normal",
                  "essential"
                ]
              },
              "backup": {
                "description": "Batteries / UPS autonomy, redundancy",
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "catalogueRevision": {
